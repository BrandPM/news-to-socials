cms.icon.finance {
    reverse_proxy directus:8055
    encode zstd gzip

    # Hardening
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output file /data/access.log {
            roll_size 10MiB
            roll_keep 7
        }
    }
}
