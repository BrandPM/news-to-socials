[Unit]
Description=News-to-Socials: dispatch publish queue
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=news-deploy
Group=news-deploy
WorkingDirectory=/opt/news-to-socials
EnvironmentFile=/opt/news-to-socials/.env
ExecStart=/opt/news-to-socials/.venv/bin/python -m pipeline.scheduler.dispatch_queue

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/news-to-socials /var/log/news-to-socials
MemoryMax=1G
CPUQuota=80%

StandardOutput=journal
StandardError=journal
