[Unit]
Description=News-to-Socials: alert on stale posts
After=network-online.target

[Service]
Type=oneshot
User=news-deploy
Group=news-deploy
WorkingDirectory=/opt/news-to-socials
EnvironmentFile=/opt/news-to-socials/.env
ExecStart=/opt/news-to-socials/.venv/bin/python -m pipeline.scheduler.stale_posts

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=256M

StandardOutput=journal
StandardError=journal
