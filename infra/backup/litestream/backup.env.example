# TEMPLATE — /etc/news-to-socials/backup.env  (structure only, NO real values)
# NTS_088. Real DO Spaces credentials live ONLY here on the VPS and in
# Bitwarden — NEVER in git or Obsidian.
#
# Install on the VPS:
#   sudo mkdir -p /etc/news-to-socials
#   sudo cp backup.env.example /etc/news-to-socials/backup.env
#   sudo nano /etc/news-to-socials/backup.env      # paste values from Bitwarden
#   sudo chown news-deploy:news-deploy /etc/news-to-socials/backup.env
#   sudo chmod 600 /etc/news-to-socials/backup.env

# Spaces access key pair (Bitwarden: "NTS DO Spaces backup keys").
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Endpoint / region / bucket for the FRA1 Space.
LITESTREAM_ENDPOINT=https://fra1.digitaloceanspaces.com
LITESTREAM_REGION=fra1
LITESTREAM_BUCKET=
