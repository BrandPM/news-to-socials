# ============================================================
# News-to-Socials — Environment variables
# Copy to .env and fill. NEVER commit .env to git.
# ============================================================

# --- LLM providers ---
# ADR-017: OpenAI-only stack. gpt-4o-mini for scoring + draft,
# gpt-4o for the polish pass.
OPENAI_API_KEY=

# --- Image generation ---
REPLICATE_API_TOKEN=

# --- Telegram approval bot + monitoring channel ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVER_CHAT_ID=
TELEGRAM_MONITORING_CHAT_ID=

# --- Meta Graph API (Facebook + Instagram) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# --- Directus headless CMS ---
DIRECTUS_URL=https://cms.icon.finance
DIRECTUS_TOKEN=

# --- Postgres (used by Directus) ---
POSTGRES_PASSWORD=
POSTGRES_USER=directus
POSTGRES_DB=directus

# --- Pipeline runtime ---
PIPELINE_DB_PATH=/var/lib/news-to-socials/pipeline.db
LOG_LEVEL=INFO
TZ=Europe/Madrid

# --- Optional: ML service URL (Stage 6 advanced dedup) ---
# Leave empty to use built-in cosine+entity dedup.
ML_SERVICE_URL=

# --- Optional: paywall fallback (Stage 1 W9) ---
# A Browser-Rendering-API-compatible URL (Cloudflare BR, ScrapingBee, etc.)
# Leave empty to skip and treat paywalled sources as headlines-only.
BROWSER_RENDER_URL=
BROWSER_RENDER_TOKEN=
