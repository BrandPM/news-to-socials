# ============================================================
# News-to-Socials — Environment variables
# Copy to .env and fill. NEVER commit .env to git.
# ============================================================

# --- LLM providers ---
# ADR-017: OpenAI-only stack. gpt-4o-mini for scoring + draft,
# gpt-4o for the polish pass.
OPENAI_API_KEY=

# --- Image generation ---
REPLICATE_API_TOKEN=

# --- Sanity CMS (ADR-018) ---
# Get these from src/lib/sanity.ts in the Lovable project.
# API token: sanity.io/manage → API → Tokens → Add (Editor permissions).
SANITY_PROJECT_ID=yqrl1o3x
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=

# --- Telegram (Wave 3 only — currently postponed, no brand channels yet) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVER_CHAT_ID=
TELEGRAM_MONITORING_CHAT_ID=

# --- Meta Graph API (Wave 2 — pending Meta App Review) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# --- Pipeline runtime ---
PIPELINE_DB_PATH=/var/lib/news-to-socials/pipeline.db
LOG_LEVEL=INFO
TZ=Europe/Madrid

# --- Optional: paywall fallback (Stage 1 W9) ---
# Browser-rendering service URL (Cloudflare BR, ScrapingBee, etc.).
# Leave empty to skip and treat paywalled sources as headlines-only.
BROWSER_RENDER_URL=
BROWSER_RENDER_TOKEN=
